{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "globals": {
    "$": "readonly",
    "jQuery": "readonly",
    "moment": "readonly"
  },
  "extends": "eslint:recommended",
  "overrides": [
    {
      "files": ["netlify/functions/**/*.js"],
      "env": {
        "browser": false,
        "node": true
      },
      "parserOptions": {
        "sourceType": "commonjs"
      }
    }
  ]
}
